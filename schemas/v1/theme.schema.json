{
  "$id": "urn:172x:marketplace:schema:v1:theme",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "appearance": { "enum": ["dark", "light"] },
        "attribution": { "minLength": 1, "maxLength": 300, "type": "string" },
        "name": { "minLength": 1, "maxLength": 80, "type": "string" }
      },
      "required": ["appearance", "attribution", "name"],
      "type": "object"
    },
    "packageId": { "$ref": "#/$defs/packageId" },
    "packageVersion": { "$ref": "#/$defs/semver" },
    "schemaVersion": { "const": 1 },
    "tokens": {
      "additionalProperties": false,
      "properties": {
        "accent": { "$ref": "#/$defs/color" },
        "background": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "danger": { "$ref": "#/$defs/color" },
        "focus": { "$ref": "#/$defs/color" },
        "info": { "$ref": "#/$defs/color" },
        "selection": { "$ref": "#/$defs/color" },
        "success": { "$ref": "#/$defs/color" },
        "surface": { "$ref": "#/$defs/color" },
        "surfaceElevated": { "$ref": "#/$defs/color" },
        "syntaxComment": { "$ref": "#/$defs/color" },
        "syntaxKeyword": { "$ref": "#/$defs/color" },
        "syntaxNumber": { "$ref": "#/$defs/color" },
        "syntaxString": { "$ref": "#/$defs/color" },
        "terminalBackground": { "$ref": "#/$defs/color" },
        "terminalForeground": { "$ref": "#/$defs/color" },
        "textMuted": { "$ref": "#/$defs/color" },
        "textPrimary": { "$ref": "#/$defs/color" },
        "textSecondary": { "$ref": "#/$defs/color" },
        "warning": { "$ref": "#/$defs/color" }
      },
      "required": [
        "accent",
        "background",
        "border",
        "danger",
        "focus",
        "info",
        "selection",
        "success",
        "surface",
        "surfaceElevated",
        "syntaxComment",
        "syntaxKeyword",
        "syntaxNumber",
        "syntaxString",
        "terminalBackground",
        "terminalForeground",
        "textMuted",
        "textPrimary",
        "textSecondary",
        "warning"
      ],
      "type": "object"
    },
    "type": { "const": "theme" }
  },
  "required": ["metadata", "packageId", "packageVersion", "schemaVersion", "tokens", "type"],
  "type": "object",
  "$defs": {
    "color": { "pattern": "^#[0-9a-fA-F]{6}$", "type": "string" },
    "packageId": { "maxLength": 96, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+){2,}$", "type": "string" },
    "semver": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" }
  }
}
