{
  "$id": "urn:172x:marketplace:schema:v1:catalog-envelope",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalogRevision": { "$ref": "#/$defs/revision" },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "catalogUri": { "$ref": "#/$defs/reference" },
    "expiresAt": { "format": "date-time", "type": "string" },
    "issuedAt": { "format": "date-time", "type": "string" },
    "revocationsSha256": { "$ref": "#/$defs/sha256" },
    "revocationsUri": { "$ref": "#/$defs/reference" },
    "schemaVersion": { "const": 1 },
    "sourceBindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "manifestSha256": { "$ref": "#/$defs/sha256" },
          "packageId": { "$ref": "#/$defs/packageId" },
          "packagePath": { "$ref": "#/$defs/reference" },
          "packageVersion": { "$ref": "#/$defs/semver" },
          "repositoryCommitSha": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
          "sourceTreeSha256": { "$ref": "#/$defs/sha256" }
        },
        "required": ["manifestSha256", "packageId", "packagePath", "packageVersion", "repositoryCommitSha", "sourceTreeSha256"],
        "type": "object"
      },
      "maxItems": 512,
      "type": "array"
    }
  },
  "required": ["catalogRevision", "catalogSha256", "catalogUri", "expiresAt", "issuedAt", "revocationsSha256", "revocationsUri", "schemaVersion", "sourceBindings"],
  "type": "object",
  "$defs": {
    "packageId": { "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+){2,}$", "type": "string" },
    "reference": { "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$", "type": "string" },
    "revision": { "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9.-]*$", "type": "string" },
    "semver": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" },
    "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
  }
}
