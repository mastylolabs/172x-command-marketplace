{
  "$id": "urn:172x:marketplace:schema:v1:panel",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "automaticPlacement": { "const": false },
    "layoutRole": { "enum": ["right-sidebar", "bottom-drawer", "workspace-area"] },
    "packageId": { "$ref": "#/$defs/packageId" },
    "packageVersion": { "$ref": "#/$defs/semver" },
    "schemaVersion": { "const": 1 },
    "slots": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "acceptedWidget": {
            "additionalProperties": false,
            "properties": {
              "apiRange": { "$ref": "#/$defs/range" },
              "typeContractMajor": { "const": 1 }
            },
            "required": ["apiRange", "typeContractMajor"],
            "type": "object"
          },
          "behaviorHints": {
            "items": { "enum": ["fixed", "resizable", "collapsible", "scrollable"] },
            "maxItems": 4,
            "type": "array",
            "uniqueItems": true
          },
          "conflicts": {
            "items": { "$ref": "#/$defs/packageId" },
            "maxItems": 16,
            "type": "array",
            "uniqueItems": true
          },
          "id": { "maxLength": 48, "pattern": "^[a-z][a-z0-9-]*$", "type": "string" },
          "occupancy": {
            "additionalProperties": false,
            "properties": {
              "maximum": { "maximum": 8, "minimum": 1, "type": "integer" },
              "minimum": { "maximum": 8, "minimum": 0, "type": "integer" },
              "overflow": { "enum": ["reject", "host-scroll"] }
            },
            "required": ["maximum", "minimum", "overflow"],
            "type": "object"
          },
          "role": { "enum": ["sidebar-primary", "sidebar-secondary", "workspace-utility"] },
          "size": {
            "additionalProperties": false,
            "properties": {
              "maxHeight": { "maximum": 12, "minimum": 1, "type": "integer" },
              "maxWidth": { "maximum": 12, "minimum": 1, "type": "integer" },
              "minHeight": { "maximum": 12, "minimum": 1, "type": "integer" },
              "minWidth": { "maximum": 12, "minimum": 1, "type": "integer" }
            },
            "required": ["maxHeight", "maxWidth", "minHeight", "minWidth"],
            "type": "object"
          }
        },
        "required": ["acceptedWidget", "behaviorHints", "conflicts", "id", "occupancy", "role", "size"],
        "type": "object"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "type": { "const": "panel" }
  },
  "required": ["automaticPlacement", "layoutRole", "packageId", "packageVersion", "schemaVersion", "slots", "type"],
  "type": "object",
  "$defs": {
    "packageId": { "maxLength": 96, "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+){2,}$", "type": "string" },
    "range": {
      "pattern": "^>=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*) <(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "semver": { "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "type": "string" }
  }
}
