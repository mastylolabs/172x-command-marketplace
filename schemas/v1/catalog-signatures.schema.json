{
  "$id": "urn:172x:marketplace:schema:v1:catalog-signatures",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "signatures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "algorithm": { "const": "Ed25519" },
          "keyId": { "pattern": "^[a-z0-9][a-z0-9-]{2,63}$", "type": "string" },
          "signature": { "pattern": "^[A-Za-z0-9_-]{86}$", "type": "string" }
        },
        "required": ["algorithm", "keyId", "signature"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": ["schemaVersion", "signatures"],
  "type": "object"
}
